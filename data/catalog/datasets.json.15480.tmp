      "path": "data/raw/live/ssurgo-statsgo2/fbede56cb3ea587ed623d969-2026-11-15T123435_0000-c2eb82871a28.json",
      "local_available": true,
      "product": "ssurgo-statsgo2",
      "version": null,
      "source_url": "https://sdmdataaccess.nrcs.usda.gov/Tabular/post.rest",
      "retrieved_at": "2026-11-15T12:34:35+00:00",
      "verified_at": "2026-11-15T12:34:35+00:00",
      "license": null,
      "license_url": null,
      "redistribution_allowed": null,
      "citation": "USDA NRCS Soil Data Access / SSURGO",
      "spatial": {
        "crs": "EPSG:4326",
        "coverage": "Request-specific; see request parameters",
        "resolution": "Native soil survey mapping units"
      },
      "temporal": {
        "start": null,
        "end": null,
        "step": null,
        "timezone": null
      },
      "variables": [
        {
          "name": "ph",
          "definition": "Depth-weighted pH of dominant component, 0–30 cm",
          "unit": "pH",
          "nodata": null
        },
        {
          "name": "awc",
          "definition": "Available water capacity, 0–30 cm",
          "unit": "cm/cm",
          "nodata": null
        },
        {
          "name": "sand",
          "definition": "Sand content",
          "unit": "%",
          "nodata": null
        },
        {
          "name": "clay",
          "definition": "Clay content",
          "unit": "%",
          "nodata": null
        },
        {
          "name": "slope_r",
          "definition": "Representative slope",
          "unit": "%",
          "nodata": null
        },
        {
          "name": "drainagecl",
          "definition": "Drainage class",
          "unit": "categorical",
          "nodata": null
        }
      ],
      "quality_notes": "Immutable upstream response. Derived outputs must validate completeness, units and spatial support. Unverified redistribution terms are null, not a permission.",
      "sha256": "c2eb82871a28b739d3f52d003ff939557687e6bbcd5bf7b93a10baa8796e11de",
      "request": {
        "url": "https://sdmdataaccess.nrcs.usda.gov/Tabular/post.rest",
        "body": {
          "query": "SELECT TOP 401 p.mupolygonkey,p.mukey,m.muname,c.compname,c.comppct_r,c.drainagecl,c.slope_r,h.ph,h.awc,h.clay,h.sand,h.om,h.depth_ph,h.depth_awc,h.depth_clay,h.depth_sand,\np.mupolygongeo.STIntersection(geometry::STGeomFromText('POLYGON((-99.854403 38.512606,-99.535956 38.512606,-99.535956 38.681115,-99.854403 38.681115,-99.854403 38.512606))',4326)).Reduce(0.00001).STAsText() wkt,\np.mupolygongeo.STIntersection(geometry::STGeomFromText('POLYGON((-99.854403 38.512606,-99.535956 38.512606,-99.535956 38.681115,-99.854403 38.681115,-99.854403 38.512606))',4326)).STPointOnSurface().STX lon,\np.mupolygongeo.STIntersection(geometry::STGeomFromText('POLYGON((-99.854403 38.512606,-99.535956 38.512606,-99.535956 38.681115,-99.854403 38.681115,-99.854403 38.512606))',4326)).STPointOnSurface().STY lat\nFROM mupolygon p JOIN mapunit m ON m.mukey=p.mukey\nOUTER APPLY (SELECT TOP 1 * FROM component WHERE mukey=p.mukey ORDER BY comppct_r DESC,cokey) c\nOUTER APPLY (\nSELECT SUM(ph1to1h2o_r * thickness)/NULLIF(SUM(CASE WHEN ph1to1h2o_r IS NOT NULL THEN thickness END),0) ph,\nSUM(awc_r * thickness)/NULLIF(SUM(CASE WHEN awc_r IS NOT NULL THEN thickness END),0) awc,\nSUM(claytotal_r * thickness)/NULLIF(SUM(CASE WHEN claytotal_r IS NOT NULL THEN thickness END),0) clay,\nSUM(sandtotal_r * thickness)/NULLIF(SUM(CASE WHEN sandtotal_r IS NOT NULL THEN thickness END),0) sand,\nSUM(om_r * thickness)/NULLIF(SUM(CASE WHEN om_r IS NOT NULL THEN thickness END),0) om,\nSUM(CASE WHEN ph1to1h2o_r IS NOT NULL THEN thickness END) depth_ph,\nSUM(CASE WHEN awc_r IS NOT NULL THEN thickness END) depth_awc,\nSUM(CASE WHEN claytotal_r IS NOT NULL THEN thickness END) depth_clay,\nSUM(CASE WHEN sandtotal_r IS NOT NULL THEN thickness END) depth_sand\nFROM (SELECT ph1to1h2o_r,awc_r,claytotal_r,sandtotal_r,om_r,\n(CASE WHEN hzdepb_r>30 THEN 30 ELSE hzdepb_r END)-(CASE WHEN hzdept_r<0 THEN 0 ELSE hzdept_r END) thickness\nFROM chorizon WHERE cokey=c.cokey AND hzdept_r<30 AND hzdepb_r>0) z\n) h\nWHERE p.mupolygonkey IN (SELECT mupolygonkey FROM SDA_Get_Mupolygonkey_from_intersection_with_WktWgs84('POLYGON((-99.854403 38.512606,-99.535956 38.512606,-99.535956 38.681115,-99.854403 38.681115,-99.854403 38.512606))'))\nORDER BY p.mupolygonkey",
          "format": "JSON+COLUMNNAME"
        }
      }
    },
