      ],
      "kind": "model_estimate",
      "is_demo": false,
      "layer": "raw",
      "path": "data/raw/live/ssurgo-statsgo2/0309f66f8ec7124bdb00d822-2026-11-14T130616_0000-5daa810ecce3.json",
      "local_available": true,
      "product": "ssurgo-statsgo2",
      "version": null,
      "source_url": "https://sdmdataaccess.nrcs.usda.gov/Tabular/post.rest",
      "retrieved_at": "2026-11-14T13:06:16+00:00",
