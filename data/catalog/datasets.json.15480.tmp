    {
      "id": "ssurgo-statsgo2-9a0aa9e1ee16a894c620fead",
      "title": "USDA SDA SSURGO query response",
      "source_ids": [
        "ssurgo-statsgo2"
      ],
      "kind": "model_estimate",
      "is_demo": false,
      "layer": "raw",
      "path": "data/raw/live/ssurgo-statsgo2/9a0aa9e1ee16a894c620fead-2026-11-14T133531_0000-9dcd870ccc0f.json",
      "local_available": true,
      "product": "ssurgo-statsgo2",
      "version": null,
      "source_url": "https://sdmdataaccess.nrcs.usda.gov/Tabular/post.rest",
      "retrieved_at": "2026-11-14T13:35:31+00:00",
      "verified_at": "2026-11-14T13:35:31+00:00",
      "license": null,
      "license_url": null,
      "redistribution_allowed": null,
      "citation": "USDA NRCS Soil Data Access / SSURGO",
      "spatial": {
        "crs": "EPSG:4326",
        "coverage": "Request-specific; see request parameters",
        "resolution": "Native soil survey mapping units"
      },
      "temporal": {
        "start": null,
        "end": null,
        "step": null,
        "timezone": null
      },
      "variables": [
        {
          "name": "ph",
          "definition": "Depth-weighted pH of dominant component, 0–30 cm",
          "unit": "pH",
          "nodata": null
        },
        {
          "name": "awc",
          "definition": "Available water capacity, 0–30 cm",
          "unit": "cm/cm",
          "nodata": null
        },
        {
          "name": "sand",
          "definition": "Sand content",
          "unit": "%",
          "nodata": null
        },
        {
          "name": "clay",
          "definition": "Clay content",
          "unit": "%",
          "nodata": null
        },
        {
          "name": "slope_r",
          "definition": "Representative slope",
          "unit": "%",
          "nodata": null
        },
        {
          "name": "drainagecl",
          "definition": "Drainage class",
          "unit": "categorical",
          "nodata": null
        }
      ],
      "quality_notes": "Immutable upstream response. Derived outputs must validate completeness, units and spatial support. Unverified redistribution terms are null, not a permission.",
      "sha256": "9dcd870ccc0f63fb3ee662e4e1c98d864d2d5b667b53e3d4fa69c61ffee8e3e5",
      "request": {
        "url": "https://sdmdataaccess.nrcs.usda.gov/Tabular/post.rest",
        "body": {
          "query": "SELECT 'grid-0.625--154-75' sample,c.mukey,c.muname,c.compname,c.comppct_r,c.drainagecl,c.slope_r,h.ph,h.awc,h.clay,h.sand,h.om,h.depth_ph,h.depth_awc,h.depth_clay,h.depth_sand\nFROM (SELECT TOP 1 m.muname,c.* FROM mapunit m JOIN component c ON c.mukey=m.mukey\nWHERE m.mukey IN (SELECT mukey FROM SDA_Get_Mukey_from_intersection_with_WktWgs84('POINT(-95.937500 37.750000)'))\nORDER BY c.comppct_r DESC,c.cokey) c OUTER APPLY (\nSELECT SUM(ph1to1h2o_r * thickness)/NULLIF(SUM(CASE WHEN ph1to1h2o_r IS NOT NULL THEN thickness END),0) ph,\nSUM(awc_r * thickness)/NULLIF(SUM(CASE WHEN awc_r IS NOT NULL THEN thickness END),0) awc,\nSUM(claytotal_r * thickness)/NULLIF(SUM(CASE WHEN claytotal_r IS NOT NULL THEN thickness END),0) clay,\nSUM(sandtotal_r * thickness)/NULLIF(SUM(CASE WHEN sandtotal_r IS NOT NULL THEN thickness END),0) sand,\nSUM(om_r * thickness)/NULLIF(SUM(CASE WHEN om_r IS NOT NULL THEN thickness END),0) om,\nSUM(CASE WHEN ph1to1h2o_r IS NOT NULL THEN thickness END) depth_ph,\nSUM(CASE WHEN awc_r IS NOT NULL THEN thickness END) depth_awc,\nSUM(CASE WHEN claytotal_r IS NOT NULL THEN thickness END) depth_clay,\nSUM(CASE WHEN sandtotal_r IS NOT NULL THEN thickness END) depth_sand\nFROM (SELECT ph1to1h2o_r,awc_r,claytotal_r,sandtotal_r,om_r,\n(CASE WHEN hzdepb_r>30 THEN 30 ELSE hzdepb_r END)-(CASE WHEN hzdept_r<0 THEN 0 ELSE hzdept_r END) thickness\nFROM chorizon WHERE cokey=c.cokey AND hzdept_r<30 AND hzdepb_r>0) z\n) h UNION ALL SELECT 'grid-0.625--153-75' sample,c.mukey,c.muname,c.compname,c.comppct_r,c.drainagecl,c.slope_r,h.ph,h.awc,h.clay,h.sand,h.om,h.depth_ph,h.depth_awc,h.depth_clay,h.depth_sand\nFROM (SELECT TOP 1 m.muname,c.* FROM mapunit m JOIN component c ON c.mukey=m.mukey\nWHERE m.mukey IN (SELECT mukey FROM SDA_Get_Mukey_from_intersection_with_WktWgs84('POINT(-95.312500 37.750000)'))\nORDER BY c.comppct_r DESC,c.cokey) c OUTER APPLY (\nSELECT SUM(ph1to1h2o_r * thickness)/NULLIF(SUM(CASE WHEN ph1to1h2o_r IS NOT NULL THEN thickness END),0) ph,\nSUM(awc_r * thickness)/NULLIF(SUM(CASE WHEN awc_r IS NOT NULL THEN thickness END),0) awc,\nSUM(claytotal_r * thickness)/NULLIF(SUM(CASE WHEN claytotal_r IS NOT NULL THEN thickness END),0) clay,\nSUM(sandtotal_r * thickness)/NULLIF(SUM(CASE WHEN sandtotal_r IS NOT NULL THEN thickness END),0) sand,\nSUM(om_r * thickness)/NULLIF(SUM(CASE WHEN om_r IS NOT NULL THEN thickness END),0) om,\nSUM(CASE WHEN ph1to1h2o_r IS NOT NULL THEN thickness END) depth_ph,\nSUM(CASE WHEN awc_r IS NOT NULL THEN thickness END) depth_awc,\nSUM(CASE WHEN claytotal_r IS NOT NULL THEN thickness END) depth_clay,\nSUM(CASE WHEN sandtotal_r IS NOT NULL THEN thickness END) depth_sand\nFROM (SELECT ph1to1h2o_r,awc_r,claytotal_r,sandtotal_r,om_r,\n(CASE WHEN hzdepb_r>30 THEN 30 ELSE hzdepb_r END)-(CASE WHEN hzdept_r<0 THEN 0 ELSE hzdept_r END) thickness\nFROM chorizon WHERE cokey=c.cokey AND hzdept_r<30 AND hzdepb_r>0) z\n) h UNION ALL SELECT 'grid-0.625--152-75' sample,c.mukey,c.muname,c.compname,c.comppct_r,c.drainagecl,c.slope_r,h.ph,h.awc,h.clay,h.sand,h.om,h.depth_ph,h.depth_awc,h.depth_clay,h.depth_sand\nFROM (SELECT TOP 1 m.muname,c.* FROM mapunit m JOIN component c ON c.mukey=m.mukey\nWHERE m.mukey IN (SELECT mukey FROM SDA_Get_Mukey_from_intersection_with_WktWgs84('POINT(-94.750000 37.750000)'))\nORDER BY c.comppct_r DESC,c.cokey) c OUTER APPLY (\nSELECT SUM(ph1to1h2o_r * thickness)/NULLIF(SUM(CASE WHEN ph1to1h2o_r IS NOT NULL THEN thickness END),0) ph,\nSUM(awc_r * thickness)/NULLIF(SUM(CASE WHEN awc_r IS NOT NULL THEN thickness END),0) awc,\nSUM(claytotal_r * thickness)/NULLIF(SUM(CASE WHEN claytotal_r IS NOT NULL THEN thickness END),0) clay,\nSUM(sandtotal_r * thickness)/NULLIF(SUM(CASE WHEN sandtotal_r IS NOT NULL THEN thickness END),0) sand,\nSUM(om_r * thickness)/NULLIF(SUM(CASE WHEN om_r IS NOT NULL THEN thickness END),0) om,\nSUM(CASE WHEN ph1to1h2o_r IS NOT NULL THEN thickness END) depth_ph,\nSUM(CASE WHEN awc_r IS NOT NULL THEN thickness END) depth_awc,\nSUM(CASE WHEN claytotal_r IS NOT NULL THEN thickness END) depth_clay,\nSUM(CASE WHEN sandtotal_r IS NOT NULL THEN thickness END) depth_sand\nFROM (SELECT ph1to1h2o_r,awc_r,claytotal_r,sandtotal_r,om_r,\n(CASE WHEN hzdepb_r>30 THEN 30 ELSE hzdepb_r END)-(CASE WHEN hzdept_r<0 THEN 0 ELSE hzdept_r END) thickness\nFROM chorizon WHERE cokey=c.cokey AND hzdept_r<30 AND hzdepb_r>0) z\n) h UNION ALL SELECT 'grid-0.625--152-76' sample,c.mukey,c.muname,c.compname,c.comppct_r,c.drainagecl,c.slope_r,h.ph,h.awc,h.clay,h.sand,h.om,h.depth_ph,h.depth_awc,h.depth_clay,h.depth_sand\nFROM (SELECT TOP 1 m.muname,c.* FROM mapunit m JOIN component c ON c.mukey=m.mukey\nWHERE m.mukey IN (SELECT mukey FROM SDA_Get_Mukey_from_intersection_with_WktWgs84('POINT(-94.750000 38.250000)'))\nORDER BY c.comppct_r DESC,c.cokey) c OUTER APPLY (\nSELECT SUM(ph1to1h2o_r * thickness)/NULLIF(SUM(CASE WHEN ph1to1h2o_r IS NOT NULL THEN thickness END),0) ph,\nSUM(awc_r * thickness)/NULLIF(SUM(CASE WHEN awc_r IS NOT NULL THEN thickness END),0) awc,\nSUM(claytotal_r * thickness)/NULLIF(SUM(CASE WHEN claytotal_r IS NOT NULL THEN thickness END),0) clay,\nSUM(sandtotal_r * thickness)/NULLIF(SUM(CASE WHEN sandtotal_r IS NOT NULL THEN thickness END),0) sand,\nSUM(om_r * thickness)/NULLIF(SUM(CASE WHEN om_r IS NOT NULL THEN thickness END),0) om,\nSUM(CASE WHEN ph1to1h2o_r IS NOT NULL THEN thickness END) depth_ph,\nSUM(CASE WHEN awc_r IS NOT NULL THEN thickness END) depth_awc,\nSUM(CASE WHEN claytotal_r IS NOT NULL THEN thickness END) depth_clay,\nSUM(CASE WHEN sandtotal_r IS NOT NULL THEN thickness END) depth_sand\nFROM (SELECT ph1to1h2o_r,awc_r,claytotal_r,sandtotal_r,om_r,\n(CASE WHEN hzdepb_r>30 THEN 30 ELSE hzdepb_r END)-(CASE WHEN hzdept_r<0 THEN 0 ELSE hzdept_r END) thickness\nFROM chorizon WHERE cokey=c.cokey AND hzdept_r<30 AND hzdepb_r>0) z\n) h UNION ALL SELECT 'grid-0.625--152-77' sample,c.mukey,c.muname,c.compname,c.comppct_r,c.drainagecl,c.slope_r,h.ph,h.awc,h.clay,h.sand,h.om,h.depth_ph,h.depth_awc,h.depth_clay,h.depth_sand\nFROM (SELECT TOP 1 m.muname,c.* FROM mapunit m JOIN component c ON c.mukey=m.mukey\nWHERE m.mukey IN (SELECT mukey FROM SDA_Get_Mukey_from_intersection_with_WktWgs84('POINT(-94.750000 38.750000)'))\nORDER BY c.comppct_r DESC,c.cokey) c OUTER APPLY (\nSELECT SUM(ph1to1h2o_r * thickness)/NULLIF(SUM(CASE WHEN ph1to1h2o_r IS NOT NULL THEN thickness END),0) ph,\nSUM(awc_r * thickness)/NULLIF(SUM(CASE WHEN awc_r IS NOT NULL THEN thickness END),0) awc,\nSUM(claytotal_r * thickness)/NULLIF(SUM(CASE WHEN claytotal_r IS NOT NULL THEN thickness END),0) clay,\nSUM(sandtotal_r * thickness)/NULLIF(SUM(CASE WHEN sandtotal_r IS NOT NULL THEN thickness END),0) sand,\nSUM(om_r * thickness)/NULLIF(SUM(CASE WHEN om_r IS NOT NULL THEN thickness END),0) om,\nSUM(CASE WHEN ph1to1h2o_r IS NOT NULL THEN thickness END) depth_ph,\nSUM(CASE WHEN awc_r IS NOT NULL THEN thickness END) depth_awc,\nSUM(CASE WHEN claytotal_r IS NOT NULL THEN thickness END) depth_clay,\nSUM(CASE WHEN sandtotal_r IS NOT NULL THEN thickness END) depth_sand\nFROM (SELECT ph1to1h2o_r,awc_r,claytotal_r,sandtotal_r,om_r,\n(CASE WHEN hzdepb_r>30 THEN 30 ELSE hzdepb_r END)-(CASE WHEN hzdept_r<0 THEN 0 ELSE hzdept_r END) thickness\nFROM chorizon WHERE cokey=c.cokey AND hzdept_r<30 AND hzdepb_r>0) z\n) h",
          "format": "JSON+COLUMNNAME"
        }
      }
