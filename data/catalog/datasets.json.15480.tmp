      "quality_notes": "Immutable upstream response. Derived outputs must validate completeness, units and spatial support. Unverified redistribution terms are null, not a permission.",
      "sha256": "97f0b0951bca0f04eb0de9e3a762921acf8a0d5f13379a9aa66098a4cc928b56",
      "request": {
        "url": "https://sdmdataaccess.nrcs.usda.gov/Tabular/post.rest",
        "body": {
          "query": "SELECT TOP 401 p.mupolygonkey,p.mukey,m.muname,c.compname,c.comppct_r,c.drainagecl,c.slope_r,h.ph,h.awc,h.clay,h.sand,h.om,h.depth_ph,h.depth_awc,h.depth_clay,h.depth_sand,\np.mupolygongeo.STIntersection(geometry::STGeomFromText('POLYGON((-98.323698 37.592199,-98.066549 37.592199,-98.066549 37.671728,-98.323698 37.671728,-98.323698 37.592199))',4326)).Reduce(0.00001).STAsText() wkt,\np.mupolygongeo.STIntersection(geometry::STGeomFromText('POLYGON((-98.323698 37.592199,-98.066549 37.592199,-98.066549 37.671728,-98.323698 37.671728,-98.323698 37.592199))',4326)).STPointOnSurface().STX lon,\np.mupolygongeo.STIntersection(geometry::STGeomFromText('POLYGON((-98.323698 37.592199,-98.066549 37.592199,-98.066549 37.671728,-98.323698 37.671728,-98.323698 37.592199))',4326)).STPointOnSurface().STY lat\nFROM mupolygon p JOIN mapunit m ON m.mukey=p.mukey\nOUTER APPLY (SELECT TOP 1 * FROM component WHERE mukey=p.mukey ORDER BY comppct_r DESC,cokey) c\nOUTER APPLY (\nSELECT SUM(ph1to1h2o_r * thickness)/NULLIF(SUM(CASE WHEN ph1to1h2o_r IS NOT NULL THEN thickness END),0) ph,\nSUM(awc_r * thickness)/NULLIF(SUM(CASE WHEN awc_r IS NOT NULL THEN thickness END),0) awc,\nSUM(claytotal_r * thickness)/NULLIF(SUM(CASE WHEN claytotal_r IS NOT NULL THEN thickness END),0) clay,\nSUM(sandtotal_r * thickness)/NULLIF(SUM(CASE WHEN sandtotal_r IS NOT NULL THEN thickness END),0) sand,\nSUM(om_r * thickness)/NULLIF(SUM(CASE WHEN om_r IS NOT NULL THEN thickness END),0) om,\nSUM(CASE WHEN ph1to1h2o_r IS NOT NULL THEN thickness END) depth_ph,\nSUM(CASE WHEN awc_r IS NOT NULL THEN thickness END) depth_awc,\nSUM(CASE WHEN claytotal_r IS NOT NULL THEN thickness END) depth_clay,\nSUM(CASE WHEN sandtotal_r IS NOT NULL THEN thickness END) depth_sand\nFROM (SELECT ph1to1h2o_r,awc_r,claytotal_r,sandtotal_r,om_r,\n(CASE WHEN hzdepb_r>30 THEN 30 ELSE hzdepb_r END)-(CASE WHEN hzdept_r<0 THEN 0 ELSE hzdept_r END) thickness\nFROM chorizon WHERE cokey=c.cokey AND hzdept_r<30 AND hzdepb_r>0) z\n) h\nWHERE p.mupolygonkey IN (SELECT mupolygonkey FROM SDA_Get_Mupolygonkey_from_intersection_with_WktWgs84('POLYGON((-98.323698 37.592199,-98.066549 37.592199,-98.066549 37.671728,-98.323698 37.671728,-98.323698 37.592199))'))\nORDER BY p.mupolygonkey",
