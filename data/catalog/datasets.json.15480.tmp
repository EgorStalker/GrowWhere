    {
      "id": "ssurgo-statsgo2-c72471dd13aa25867ce6644c",
      "title": "USDA SDA SSURGO query response",
      "source_ids": [
        "ssurgo-statsgo2"
      ],
      "kind": "model_estimate",
      "is_demo": false,
      "layer": "raw",
      "path": "data/raw/live/ssurgo-statsgo2/c72471dd13aa25867ce6644c-2026-11-14T115631_0000-27eab3351e6a.json",
      "local_available": true,
      "product": "ssurgo-statsgo2",
      "version": null,
      "source_url": "https://sdmdataaccess.nrcs.usda.gov/Tabular/post.rest",
      "retrieved_at": "2026-11-14T11:56:31+00:00",
      "verified_at": "2026-11-14T11:56:31+00:00",
      "license": null,
      "license_url": null,
      "redistribution_allowed": null,
      "citation": "USDA NRCS Soil Data Access / SSURGO",
      "spatial": {
        "crs": "EPSG:4326",
        "coverage": "Request-specific; see request parameters",
        "resolution": "Native soil survey mapping units"
      },
      "temporal": {
        "start": null,
        "end": null,
        "step": null,
        "timezone": null
      },
      "variables": [
        {
          "name": "ph",
          "definition": "Depth-weighted pH of dominant component, 0–30 cm",
          "unit": "pH",
          "nodata": null
        },
        {
          "name": "awc",
          "definition": "Available water capacity, 0–30 cm",
          "unit": "cm/cm",
          "nodata": null
        },
        {
          "name": "sand",
          "definition": "Sand content",
          "unit": "%",
          "nodata": null
        },
        {
          "name": "clay",
          "definition": "Clay content",
          "unit": "%",
          "nodata": null
        },
        {
          "name": "slope_r",
          "definition": "Representative slope",
          "unit": "%",
          "nodata": null
        },
        {
          "name": "drainagecl",
          "definition": "Drainage class",
          "unit": "categorical",
          "nodata": null
        }
      ],
      "quality_notes": "Immutable upstream response. Derived outputs must validate completeness, units and spatial support. Unverified redistribution terms are null, not a permission.",
      "sha256": "27eab3351e6adacfcd246d0faae3e85f14f8cc6af5918b115fceb7cd858a5cf3",
      "request": {
        "url": "https://sdmdataaccess.nrcs.usda.gov/Tabular/post.rest",
        "body": {
          "query": "SELECT TOP 401 p.mupolygonkey,p.mukey,m.muname,c.compname,c.comppct_r,c.drainagecl,c.slope_r,h.ph,h.awc,h.clay,h.sand,h.om,h.depth_ph,h.depth_awc,h.depth_clay,h.depth_sand,\np.mupolygongeo.STIntersection(geometry::STGeomFromText('POLYGON((-100.127657 37.488821,-100.118065 37.488821,-100.118065 37.493716,-100.127657 37.493716,-100.127657 37.488821))',4326)).Reduce(0.00001).STAsText() wkt,\np.mupolygongeo.STIntersection(geometry::STGeomFromText('POLYGON((-100.127657 37.488821,-100.118065 37.488821,-100.118065 37.493716,-100.127657 37.493716,-100.127657 37.488821))',4326)).STPointOnSurface().STX lon,\np.mupolygongeo.STIntersection(geometry::STGeomFromText('POLYGON((-100.127657 37.488821,-100.118065 37.488821,-100.118065 37.493716,-100.127657 37.493716,-100.127657 37.488821))',4326)).STPointOnSurface().STY lat\nFROM mupolygon p JOIN mapunit m ON m.mukey=p.mukey\nOUTER APPLY (SELECT TOP 1 * FROM component WHERE mukey=p.mukey ORDER BY comppct_r DESC,cokey) c\nOUTER APPLY (\nSELECT SUM(ph1to1h2o_r * thickness)/NULLIF(SUM(CASE WHEN ph1to1h2o_r IS NOT NULL THEN thickness END),0) ph,\nSUM(awc_r * thickness)/NULLIF(SUM(CASE WHEN awc_r IS NOT NULL THEN thickness END),0) awc,\nSUM(claytotal_r * thickness)/NULLIF(SUM(CASE WHEN claytotal_r IS NOT NULL THEN thickness END),0) clay,\nSUM(sandtotal_r * thickness)/NULLIF(SUM(CASE WHEN sandtotal_r IS NOT NULL THEN thickness END),0) sand,\nSUM(om_r * thickness)/NULLIF(SUM(CASE WHEN om_r IS NOT NULL THEN thickness END),0) om,\nSUM(CASE WHEN ph1to1h2o_r IS NOT NULL THEN thickness END) depth_ph,\nSUM(CASE WHEN awc_r IS NOT NULL THEN thickness END) depth_awc,\nSUM(CASE WHEN claytotal_r IS NOT NULL THEN thickness END) depth_clay,\nSUM(CASE WHEN sandtotal_r IS NOT NULL THEN thickness END) depth_sand\nFROM (SELECT ph1to1h2o_r,awc_r,claytotal_r,sandtotal_r,om_r,\n(CASE WHEN hzdepb_r>30 THEN 30 ELSE hzdepb_r END)-(CASE WHEN hzdept_r<0 THEN 0 ELSE hzdept_r END) thickness\nFROM chorizon WHERE cokey=c.cokey AND hzdept_r<30 AND hzdepb_r>0) z\n) h\nWHERE p.mupolygonkey IN (SELECT mupolygonkey FROM SDA_Get_Mupolygonkey_from_intersection_with_WktWgs84('POLYGON((-100.127657 37.488821,-100.118065 37.488821,-100.118065 37.493716,-100.127657 37.493716,-100.127657 37.488821))'))\nORDER BY p.mupolygonkey",
          "format": "JSON+COLUMNNAME"
        }
      }
    },
