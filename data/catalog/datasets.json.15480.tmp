    {
      "id": "ssurgo-statsgo2-e1df6af666bb9802100252a2",
      "title": "USDA SDA SSURGO query response",
      "source_ids": [
        "ssurgo-statsgo2"
      ],
      "kind": "model_estimate",
      "is_demo": false,
      "layer": "raw",
